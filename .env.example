# TitaniumBOE-Sim Environment Configuration
# Copy this file to .env and customize for your environment
# DO NOT commit .env file to version control
#
# NOTE: every variable listed here is actually read by the application.
# Anything not listed is configured in code (see ServerConfiguration).

# ============================================
# DEMO MODE (Testing/Development Only)
# ============================================
# Shown in the startup banner. Demo users below are seeded whenever the
# user store is empty, regardless of this flag.
# NEVER enable in production environments
DEMO_MODE=true

# Demo user credentials (used when the user database is empty)
# NOTE: Usernames must be 4 characters or less (BOE protocol requirement)
#       Passwords must be 10 characters or less (BOE protocol requirement)
DEMO_USER_1=TRD1
DEMO_PASS_1=Pass1234!

DEMO_USER_2=TRD2
DEMO_PASS_2=Pass5678!

DEMO_ADMIN=ADMN
DEMO_ADMIN_PASS=Admin999!

# ============================================
# SERVER CONFIGURATION
# ============================================
# BOE Protocol server port
BOE_PORT=8081

# REST API + dashboard port
# NOTE: if the hosting platform injects PORT (Railway, Render, Heroku),
#       PORT takes precedence over API_PORT.
API_PORT=9091

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Allowed CORS origins (comma-separated), read by CorsFilter
# For development: local dev servers
# For production: your specific domain(s)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4321,http://localhost:5173,http://localhost:8080

# ============================================
# DATABASE CONFIGURATION
# ============================================
# RocksDB data directory is a JVM system property, not an env var:
#   java -Dcboe.db.path=/var/lib/boe/db -jar boe-simulator.jar
# Default: ./data/cboe_server
